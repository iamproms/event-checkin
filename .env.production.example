APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:REPLACE_ME@DB_HOST:5432/DB_NAME?sslmode=verify-full
IDENTITY_DATABASE_URL=postgresql+psycopg://IDENTITY_USER:REPLACE_ME@DB_HOST:5432/DB_NAME?sslmode=verify-full
PLATFORM_DATABASE_URL=postgresql+psycopg://PLATFORM_USER:REPLACE_ME@DB_HOST:5432/DB_NAME?sslmode=verify-full
JOBS_DATABASE_URL=postgresql+psycopg://JOBS_USER:REPLACE_ME@DB_HOST:5432/DB_NAME?sslmode=verify-full
DISPATCHER_DATABASE_URL=postgresql+psycopg://DISPATCHER_USER:REPLACE_ME@DB_HOST:5432/DB_NAME?sslmode=verify-full
JOBS_OPERATOR_DATABASE_URL=postgresql+psycopg://OPERATOR_USER:REPLACE_ME@DB_HOST:5432/DB_NAME?sslmode=verify-full
DOMAIN_WORKER_DATABASE_URL=postgresql+psycopg://DOMAIN_WORKER_USER:REPLACE_ME@DB_HOST:5432/DB_NAME?sslmode=verify-full
DOMAIN_SCHEDULER_DATABASE_URL=postgresql+psycopg://DOMAIN_SCHEDULER_USER:REPLACE_ME@DB_HOST:5432/DB_NAME?sslmode=verify-full
PLATFORM_HOST=platform.events.example.test
FALLBACK_DOMAIN_SUFFIX=events.example.test
INGRESS_PROXY_IPS=127.0.0.1
ORIGIN_AUTH_SECRET=REPLACE_WITH_EDGE_TO_ORIGIN_SECRET
AUTH_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
AUTH_KEY_ID=v1
COMPROMISED_PASSWORD_CORPUS=REPLACE_WITH_APPROVED_VERSIONED_CORPUS_PATH
COMPROMISED_PASSWORD_SHA256=REPLACE_WITH_CORPUS_FILE_SHA256
REDIS_URL=rediss://REPLACE_WITH_PRIVATE_REDIS_URL
STORAGE_ENDPOINT_URL=https://REPLACE_WITH_PRIVATE_S3_ENDPOINT
STORAGE_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
STORAGE_ACCESS_KEY=REPLACE_ME
STORAGE_SECRET_KEY=REPLACE_ME
STORAGE_REGION=REPLACE_WITH_APPROVED_REGION
TICKET_KEYRING_JSON=REPLACE_WITH_SECRET_JSON_OBJECT
TICKET_ACTIVE_KEY_VERSION=1
TICKET_ISSUANCE_ENABLED=true
REGISTRATION_RATE_HMAC_KEY=REPLACE_WITH_RANDOM_SECRET
EMAIL_SMTP_HOST=REPLACE_WITH_APPROVED_PROVIDER_HOST
EMAIL_SMTP_PORT=587
EMAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
LOG_LEVEL=INFO

