APP_ENV=local
DATABASE_URL=postgresql+psycopg://eventcheckin_app:local_app_only@localhost:5433/eventcheckin
IDENTITY_DATABASE_URL=postgresql+psycopg://eventcheckin_identity_app:local_identity_only@localhost:5433/eventcheckin
JOBS_DATABASE_URL=postgresql+psycopg://eventcheckin_jobs_app:local_jobs_only@localhost:5433/eventcheckin
DISPATCHER_DATABASE_URL=postgresql+psycopg://eventcheckin_dispatcher_app:local_dispatcher_only@localhost:5433/eventcheckin
JOBS_OPERATOR_DATABASE_URL=postgresql+psycopg://eventcheckin_job_operator_app:local_operator_only@localhost:5433/eventcheckin
REDIS_URL=redis://localhost:6380/0
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=eventcheckin-private
STORAGE_ACCESS_KEY=local_object_key
STORAGE_SECRET_KEY=local_object_secret_only
UPLOAD_URL_SECONDS=600
DOWNLOAD_URL_SECONDS=300
AUTH_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
AUTH_KEY_ID=v1
COMPROMISED_PASSWORD_CORPUS=REPLACE_WITH_APPROVED_VERSIONED_CORPUS_PATH
COMPROMISED_PASSWORD_SHA256=REPLACE_WITH_CORPUS_FILE_SHA256
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_FROM=staff@local.example.test
LOG_LEVEL=INFO

