APP_ENV=staging
DATABASE_URL=postgresql+psycopg://USER:REPLACE_ME@DB_HOST:5432/DB_NAME?sslmode=require
IDENTITY_DATABASE_URL=postgresql+psycopg://IDENTITY_USER:REPLACE_ME@DB_HOST:5432/DB_NAME?sslmode=require
AUTH_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
AUTH_KEY_ID=v1
COMPROMISED_PASSWORD_CORPUS=REPLACE_WITH_APPROVED_VERSIONED_CORPUS_PATH
COMPROMISED_PASSWORD_SHA256=REPLACE_WITH_CORPUS_FILE_SHA256
LOG_LEVEL=INFO

